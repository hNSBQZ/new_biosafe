# Compose settings. Keep the real production file outside Git if preferred and
# pass it with BIOSAFE_ENV_FILE=/absolute/path/to/biosafe.env.
BIOSAFE_BIND_ADDRESS=127.0.0.1
BIOSAFE_HTTP_PORT=8192
BIOSAFE_IMAGE=new-biosafe:latest
BIOSAFE_DATA_VOLUME=biosafe-data
BIOSAFE_LOG_VOLUME=biosafe-logs

# Override this with a name from the production registry when public Docker Hub
# is unavailable. python:3.12-slim matches the old production project.
PYTHON_BASE_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple

# Application settings. Container paths below are enforced by Compose.
BIOSAFE_ENV=production
BIOSAFE_LOG_LEVEL=INFO
BIOSAFE_CORS_ORIGINS=https://biosafe.example.com

# RAGFlow knowledge retrieval. Use host.docker.internal for a service on the
# Docker host, or use the real LAN/DNS address of a remote RAGFlow instance.
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=replace-me
RAGFLOW_TIMEOUT_SECONDS=30
RAGFLOW_DATASET_IDS=replace-with-dataset-id

# First-pass decision and final answer model.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_API_KEY=replace-me
CHAT_MODEL=replace-me
CHAT_TIMEOUT_SECONDS=60

# Independent asynchronous correction model. Set false to disable it.
CORRECTION_ENABLED=false
CORRECTION_BASE_URL=https://api.example.com/v1
CORRECTION_API_KEY=replace-me
CORRECTION_MODEL=replace-me
CORRECTION_TIMEOUT_SECONDS=120
CORRECTION_QUEUE_MAXSIZE=200
CORRECTION_WORKER_COUNT=2
CORRECTION_DRAIN_TIMEOUT_SECONDS=30

# Voice services. ws:// and http:// are valid for container-to-service traffic;
# the public browser entry still needs HTTPS for microphone permission.
ASR_URI=ws://host.docker.internal:10095
ASR_CONNECT_TIMEOUT=10
ASR_RECOGNIZE_TIMEOUT=60

TTS_BASE_URL=http://host.docker.internal:50000/v1/audio/speech
TTS_MODEL=replace-me
TTS_VOICE=replace-me
TTS_RESPONSE_FORMAT=pcm
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT=60
TTS_MAX_CONCURRENT=2
TTS_MAX_RETRIES=1
TTS_RETRY_BASE_DELAY=0.25

# Administrator credentials. Generate a unique secret with at least 32 random
# characters. The password is hashed into the persistent SQLite database.
BIOSAFE_ADMIN_USERNAME=admin
BIOSAFE_ADMIN_PASSWORD=replace-me
BIOSAFE_ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
BIOSAFE_ADMIN_TOKEN_TTL_SECONDS=28800
